// Firestore 安全规则 —— 项目 my-expense-tracker-a1aee
//
// ⚠️ 这个文件是**底稿，不是正本**。
// Firestore 的规则只能在 Firebase Console 网页后台改，仓库里的文件不会自动生效。
// 留这份底稿的原因：Console 里的规则在仓库里完全查不到，稽核时看代码看不出来
// （2026-07-16 就因为这个，测试模式的「谁都能读写全库」规则挂了一段时间才被发现）。
//
// 改了 Console 里的规则，请顺手把这份底稿同步更新。
//
// 两处占位符必须换成真值再贴进 Console：
//   BOSS_UID_HERE  → Firebase Console → Authentication → Users → jarixhew@gmail.com 那行的 User UID
//   PASSCODE_HERE  → 老板自己定的口令，私下发给同事，同事版页面里输入一次存起来
//                    （口令**故意不写进网页源码**——网址是公开的 GitHub Pages，
//                     写进源码等于没有口令。它只住在这份规则里和同事手机的 localStorage 里。）

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 老板自己的账本（2026-07-16 建立）──
    // 整份 data 一个 JSON 字符串存在 users/{uid}，收据照片在 users/{uid}/attachments
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 投递箱：同事版把账丢进来，老板 App 收走后删掉 ──
    //
    // 为什么是投递箱、而不是让同事直接写老板的账本：
    // 账本在云端是「整份 data 压成一个 JSON 字符串」存的，两边同时写会整本互相覆盖
    // （2026-07-23 已经栽过一次，日本旅行记的账被云端旧快照整份盖掉）。
    // 投递箱一条一个文档、只增不改，物理上没有覆盖账本的路径。
    match /inbox_boss/{docId} {

      // 老板本人：能看、能删（收件后清空）
      allow read, delete: if request.auth != null
                          && request.auth.uid == 'BOSS_UID_HERE';

      // 同事：只能新增一条，不能读、不能改、不能删
      // （所以同事看不到老板的账本，也看不到别的同事塞了什么）
      allow create: if request.auth != null
                    && request.resource.data.k == 'PASSCODE_HERE'
                    && request.resource.data.keys().hasAll(['k','tx','from'])
                    && request.resource.data.keys().hasOnly(['k','tx','photo','from','createdAt'])
                    && request.resource.data.tx is string
                    && request.resource.data.tx.size() < 4000
                    && request.resource.data.from is string
                    && request.resource.data.from.size() < 40
                    && (!('photo' in request.resource.data)
                        || (request.resource.data.photo is string
                            && request.resource.data.photo.size() < 760000));

      // 塞进来的东西谁也改不了（防止事后偷偷改金额）
      allow update: if false;
    }

    // ── 给同事现金：老板 App 推一笔，同事版「手上现金」卡自动看到 ──
    // 跟 inbox_boss 方向相反、原理相同：单据一条一个文档、只增不改，
    // 物理上没有覆盖任何账本的路径。
    match /boss_cash_gifts/{docId} {

      // 老板本人：能新增（给现金）。person 是收件人（同事的名字）——老板账口令是
      // 共用的，不止一个同事可能用同一个口令，「手上现金」却是每个同事本机各自算的；
      // 没有 person，这笔钱会被所有持有这个口令的同事同时收到。person 只用来给
      // 同事那边过滤（doc.data().person === 他自己的名字），这里不用为它加读取限制
      // ——跟 inbox_boss 一样，规则只守口令这一道闸。
      allow create: if request.auth != null
                    && request.auth.uid == 'BOSS_UID_HERE'
                    && request.resource.data.k == 'PASSCODE_HERE'
                    && request.resource.data.keys().hasAll(['k','person','amount','currency','at'])
                    && request.resource.data.keys().hasOnly(['k','person','amount','currency','at','note'])
                    && request.resource.data.person is string
                    && request.resource.data.person.size() > 0
                    && request.resource.data.person.size() < 40
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount < 1000000
                    && request.resource.data.currency is string
                    && request.resource.data.currency.size() < 6
                    && request.resource.data.at is number
                    && (!('note' in request.resource.data)
                        || (request.resource.data.note is string
                            && request.resource.data.note.size() < 200));

      // 同事：口令对得上才能读（不能改、不能删——历史不能被后来改掉）
      allow read: if request.auth != null && resource.data.k == 'PASSCODE_HERE';

      // 撤回：只有老板本人能删整笔（比如币种打错了）。update 继续禁止——
      // 不许悄悄改金额，只许整笔撤回，撤回后同事那边下次核对时会自己发现少了这笔。
      allow delete: if request.auth != null && request.auth.uid == 'BOSS_UID_HERE';
      allow update: if false;
    }
  }
}
