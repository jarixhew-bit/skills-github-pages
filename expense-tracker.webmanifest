{
  "name": "记账本",
  "short_name": "记账本",
  "description": "Multi-account expense tracker",
  "start_url": "expense-tracker.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1E7A42",
  "theme_color": "#1E7A42",
  "icons": [
    {
      "src": "expense-tracker-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "expense-tracker-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "https://jarixhew-bit.github.io/skills-github-pages/expense-tracker.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "photo", "accept": ["image/*"] }
      ]
    }
  }
}
