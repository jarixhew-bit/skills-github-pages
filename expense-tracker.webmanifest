{
  "name": "记账本",
  "short_name": "记账本",
  "description": "Multi-account expense tracker",
  "start_url": "expense-tracker.html",
  "_scope_note": "scope 必须只圈住自己这一页，不能写 './'。这份 manifest 在仓库根目录，'./' 会解析成整个 /skills-github-pages/ 文件夹，把 inventory/ 和 staff/ 也圈进来——浏览器于是认为库存页是记账本的一部分，装库存时提示「已经安装过」、不给单独装（2026-08-10 用户实机遇到，检查见 tools/check-pwa-scopes.py）。本页没有任何站内跳转，收窄不影响使用；share_target 的 action 就是这一页，仍在范围内。",
  "scope": "expense-tracker.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1E7A42",
  "theme_color": "#1E7A42",
  "icons": [
    {
      "src": "expense-tracker-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "expense-tracker-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "https://jarixhew-bit.github.io/skills-github-pages/expense-tracker.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "photo", "accept": ["image/*"] }
      ]
    }
  }
}
